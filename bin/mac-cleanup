#!/usr/bin/env bash

# Mole (https://github.com/tw93/mole) does the cleanup: Trash, caches, logs,
# browsers, app leftovers, npm/yarn/pnpm/bun/pip/composer, brew, puppeteer,
# system logs and crash reports. Only what Mole deliberately leaves alone
# is handled below.

if command -v mo &>/dev/null; then
  # cache sudo credentials up front, otherwise Mole skips system caches and logs
  sudo -v

  mo clean
  mo optimize
  # mo purge   # interactive removal of old project build artifacts
else
  echo "mole is not installed: brew install mole" >&2
fi

# Mole only reports Docker usage, it never prunes it
if command -v docker &>/dev/null && docker info &>/dev/null; then
  docker system prune --all --force
fi

# Mole only lists Time Machine local snapshots, it never deletes them
if command -v tmutil &>/dev/null; then
  while read -r snapshot; do
    sudo tmutil deletelocalsnapshots "$snapshot"
  done < <(tmutil listlocalsnapshotdates | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}')
fi
