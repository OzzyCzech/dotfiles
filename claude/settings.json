{
  "$schema": "https://json.schemastore.ogrep/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(glab *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(ni *)",
      "Bash(nr *)",
      "Bash(nlx *)",
      "Bash(nup *)",
      "Bash(nun *)",
      "Bash(nci *)",
      "Bash(nd *)",
      "Bash(na *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rmdir *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(date *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(open *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/config.local.php)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/config.local.php)",
      "Edit(~/.ssh/**)",
      "Edit(**/node_modules/**)",
      "Bash(chmod 777 *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(eval *)",
      "Bash(exec *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "nette@nette": true,
    "frontend-design@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "nette": {
      "source": {
        "source": "github",
        "repo": "nette/claude-code"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Revealing the CONTENTS of secret files with ANY tool. Covers .env and .env.*, anything under a secrets/ directory, ~/.ssh and other private keys, *.pem, and config.local.php. This includes shell commands (cat, head, tail, grep, sed, awk, sort, strings, base64, dd, python, node), copying them elsewhere, and sending them over the network. Metadata only (ls, wc, stat, git check-ignore) is allowed. Stated intent, testing, or debugging does NOT clear this."
    ]
  },
  "voiceEnabled": false
}
