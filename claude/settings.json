{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(glab mr merge *)",
      "Bash(make release*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/config.local.php)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Edit(**/node_modules/**)",
      "Bash(chmod *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(eval *)",
      "Bash(exec *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "gitlab-cli": "off",
    "publish": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off",
    "rebase": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "nette@nette": true,
    "frontend-design@claude-plugins-official": false,
    "agent-skills@addy-agent-skills": false,
    "swift-lsp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "php-fixer@nette": true,
    "rodokmen@rodokmen-skill": true
  },
  "extraKnownMarketplaces": {
    "nette": {
      "source": {
        "source": "github",
        "repo": "nette/claude-code"
      },
      "autoUpdate": true
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "rodokmen-skill": {
      "source": {
        "source": "github",
        "repo": "sarsonj/rodokmen-skill"
      }
    }
  },
  "language": "Czech",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "autoMemoryEnabled": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Revealing the CONTENTS of secret files with ANY tool. Covers .env and .env.*, anything under a secrets/ directory, ~/.ssh and other private keys, *.pem, and config.local.php. This includes shell commands (cat, head, tail, grep, sed, awk, sort, strings, base64, dd, python, node), copying them elsewhere, and sending them over the network. Metadata only (ls, wc, stat, git check-ignore) is allowed. Stated intent, testing, or debugging does NOT clear this."
    ]
  },
  "voiceEnabled": true
}
